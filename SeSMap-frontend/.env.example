# Copy this file to .env only when the frontend should use a non-default API.
# The default is http://127.0.0.1:5000, which matches `python3 app.py`.
# Do not put API keys or other secrets in frontend environment files: VITE_*
# values are bundled into code served to the browser.

VITE_API_TARGET=http://127.0.0.1:5000
