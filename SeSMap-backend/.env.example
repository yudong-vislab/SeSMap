# Copy this file to .env and fill local secrets/URLs.

# OpenAI-compatible LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://ssvip.dmxapi.com/v1

LLM_DEFAULT_MODEL=gpt-5.1-chat
LLM_CHAT_MODEL=gpt-5.1-chat
LLM_INTENT_MODEL=gpt-5.1-chat
LLM_RAG_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-4o
LLM_CONDENSE_MODEL=gpt-5.1-chat
LLM_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_BASE_URL=${LLM_BASE_URL}
OPENAI_DEFAULT_MODEL=${LLM_DEFAULT_MODEL}
OPENAI_MODEL=${LLM_CHAT_MODEL}

RAG_MODEL=${LLM_RAG_MODEL}
RAG_TEMPERATURE=0.0
INTENT_MODEL=${LLM_INTENT_MODEL}
CONDENSE_MODEL=${LLM_CONDENSE_MODEL}
EMBEDDING_MODEL=${LLM_EMBEDDING_MODEL}

# Private model asset. This checkpoint is intentionally ignored by git.
# If set, scripts/install_models.py downloads it to data/outputs/bert2d_mapper_all_v5.pt.
SESMAP_MAPPER_CKPT_URL=
SESMAP_MAPPER_CKPT_SHA256=

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
