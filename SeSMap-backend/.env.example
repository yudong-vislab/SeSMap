# Copy this file to .env. Keep .env local: it may contain an API key and is
# ignored by Git. The only required value to run LLM-powered features is
# LLM_API_KEY (or the legacy OPENAI_API_KEY alias below).

# Required: API key for an OpenAI-compatible LLM provider.
LLM_API_KEY=
# Optional: leave as-is for the project's configured provider, or replace with
# your provider's OpenAI-compatible API root (usually ending in /v1).
LLM_BASE_URL=https://ssvip.dmxapi.com/v1

# Optional model routing. These defaults preserve the current project setup.
LLM_DEFAULT_MODEL=gpt-5.1-chat
LLM_CHAT_MODEL=gpt-5.1-chat
LLM_INTENT_MODEL=gpt-5.1-chat
LLM_RAG_MODEL=gpt-4o
LLM_SUMMARY_MODEL=gpt-4o
LLM_CONDENSE_MODEL=gpt-5.1-chat
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Legacy OpenAI-style aliases. They are derived from the LLM_* values above;
# normally they do not need to be edited.
OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_BASE_URL=${LLM_BASE_URL}
OPENAI_DEFAULT_MODEL=${LLM_DEFAULT_MODEL}
OPENAI_MODEL=${LLM_CHAT_MODEL}
RAG_MODEL=${LLM_RAG_MODEL}
INTENT_MODEL=${LLM_INTENT_MODEL}
CONDENSE_MODEL=${LLM_CONDENSE_MODEL}
EMBEDDING_MODEL=${LLM_EMBEDDING_MODEL}

# Optional private mapper checkpoint. If both are set, install_models.py can
# download and verify it. The downloaded checkpoint is intentionally ignored.
SESMAP_MAPPER_CKPT_URL=
SESMAP_MAPPER_CKPT_SHA256=

# Optional runtime settings.
DEFAULT_CASE=case3
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
RAG_TEMPERATURE=0.0

# Optional local path / pipeline overrides (uncomment only when needed).
# BGE_MODEL_PATH=/absolute/path/to/bge-large-en-v1.5
# SESMAP_DATA_ROOT=/absolute/path/to/data
# SESMAP_MAPPER_CKPT=/absolute/path/to/bert2d_mapper_all_v10.pt
# MINERU_CMD=mineru -p {pdf} -o {out}
# MINERU_BACKEND=pipeline
