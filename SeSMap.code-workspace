{
  "folders": [
    { "name": "backend",  "path": "SeSMap-backend" },
    { "name": "frontend", "path": "SeSMap-frontend" }
  ],
  "settings": {
    "python.terminal.activateEnvironment": true
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "backend: run app",
        "type": "shell",
        "command": "python app.py",
        "options": { "cwd": "${workspaceFolder:backend}" },
        "problemMatcher": []
      },
      {
        "label": "frontend: dev",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder:frontend}" },
        "problemMatcher": []
      },
      {
        "label": "Start All (backend + frontend)",
        "dependsOn": ["backend: run app", "frontend: dev"],
        "dependsOrder": "parallel",
        "problemMatcher": []
      }
    ]
  }
}
